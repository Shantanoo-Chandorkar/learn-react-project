---
import MainLayout from '../layouts/MainLayout.astro';
import FeedbackForm from '../components/layout/FeedbackForm.jsx';
import '../styles/editorial.css';
---

<MainLayout
    title="EscapeTheSurface | Feedback"
    description="Send feedback, suggestions, or a bug report about EscapeTheSurface."
>
    <div class="editorial-page">
        <div class="editorial-hero">
            <h1>Feedback</h1>
            <p>Found a bug, have a suggestion, or just want to say something? Send it here.</p>
        </div>

        <div class="editorial-section">
            <FeedbackForm client:load />
        </div>
    </div>
</MainLayout>
