---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCategorySummaries } from '../../utils/getCategorySummaries';
import '../../styles/editorial.css';

const categories = await getCategorySummaries();
---

<MainLayout
    title="Categories | EscapeTheSurface"
    description="Every lesson on EscapeTheSurface, grouped by category."
    currentPath="/categories"
>
    <div class="editorial-page">
        <div class="editorial-hero">
            <h1>Categories</h1>
            <p>Every lesson on this site sits in one of these. Pick one to see everything inside it.</p>
        </div>

        <div class="editorial-category-grid">
            {categories.map((category) => (
                <a class="editorial-category-link-block" href={`/categories/${category.slug}`}>
                    <div class="editorial-category-block">
                        <h2 class="editorial-category-name">{category.name}</h2>
                        {category.description && <p class="editorial-category-desc">{category.description}</p>}
                        <span class="editorial-category-count">
                            {category.count} lesson{category.count === 1 ? '' : 's'}
                        </span>
                    </div>
                </a>
            ))}
        </div>
    </div>
</MainLayout>
