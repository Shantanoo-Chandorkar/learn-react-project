# Copy to .env and fill in real values. .env is gitignored - never commit real keys.
# In production these are set in Netlify's site environment variables, not in source.

# Resend API key (https://resend.com/api-keys). Server-only - read via import.meta.env in
# src/pages/api/feedback.js, never exposed to the client bundle (no VITE_ prefix).
RESEND_API_KEY=

# Free-tier Resend accounts can only send from the sandbox address - no domain verification
# possible, so this is fixed rather than a placeholder.
RESEND_FROM_EMAIL=

# Address that receives feedback form submissions.
FEEDBACK_TO_EMAIL=
